# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local: mongodb://localhost:27017/b2b_rfq
# For Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/b2b_rfq
MONGODB_URI=mongodb://localhost:27017/b2b_rfq

# JWT Secret — use a long, random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
